# --- Application ---
APP_NAME="AI Cost & Usage Platform"
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- PostgreSQL (used by docker-compose and by the app) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ai_cost_platform

# Must use the SAME user, password and database name as above.
DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5432/ai_cost_platform
# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- AI provider keys (added in the provider phases; leave blank for now) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=